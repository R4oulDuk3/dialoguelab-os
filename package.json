{
  "name": "dialoguelab-local",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first dialogue video studio",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-hyperframes-studio-style.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "mcp": "tsx mcp/server.ts",
    "build:mcp": "node scripts/build-mcp.mjs",
    "pack:mcp": "npm run build:mcp && npm pack ./packages/dialoguelab-mcp",
    "package:standalone": "node scripts/package-standalone.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "verify:character-mcp": "node scripts/verify-character-mcp.mjs",
    "verify:database-migrations": "tsx scripts/verify-database-migrations.ts",
    "verify:production-guards": "tsx scripts/verify-production-guards.ts",
    "verify:data-backup": "node scripts/verify-data-backup.mjs",
    "verify:package-mcp": "node scripts/verify-packed-mcp.mjs",
    "verify:character-edit": "tsx scripts/verify-character-edit.ts",
    "verify:background-mcp": "node scripts/verify-background-mcp.mjs",
    "verify:tts": "tsx scripts/verify-tts.ts",
    "verify:tts-mcp": "node scripts/verify-tts-mcp.mjs",
    "verify:projects": "tsx scripts/verify-projects.ts",
    "verify:project-mcp": "node scripts/verify-project-mcp.mjs",
    "verify:dialogue-timeline": "tsx scripts/verify-dialogue-timeline.ts",
    "verify:editor-history": "tsx scripts/verify-editor-history.ts",
    "verify:freeform-timeline": "tsx scripts/verify-freeform-timeline.ts",
    "verify:p0-editor": "tsx scripts/verify-p0-editor.ts",
    "verify:visual-motion": "tsx scripts/verify-visual-motion.ts",
    "verify:animation-picker": "tsx scripts/verify-animation-picker.ts",
    "verify:dialogue-parity": "tsx scripts/verify-dialogue-parity.ts",
    "verify:reddit-story": "tsx scripts/verify-reddit-story.ts",
    "verify:parity-completion": "tsx scripts/verify-parity-completion.ts",
    "verify:fake-text": "tsx scripts/verify-fake-text.ts",
    "demo:text-story": "tsx scripts/create-text-story-demo.ts",
    "verify:hyperframes": "tsx scripts/verify-hyperframes-render.ts",
    "setup:whisper": "python -m pip install -r requirements-whisper.txt",
    "check:privacy": "node scripts/check-repository-privacy.mjs",
    "check:versions": "node scripts/check-version-sync.mjs",
    "check:release": "node scripts/check-release-metadata.mjs",
    "release:prepare": "node scripts/prepare-release-metadata.mjs",
    "doctor": "node scripts/doctor.mjs",
    "data:backup": "node scripts/data-backup.mjs backup",
    "data:restore": "node scripts/data-backup.mjs restore",
    "test": "node scripts/test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fjalla-one": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/league-spartan": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@hyperframes/core": "0.7.107",
    "@hyperframes/player": "0.7.107",
    "@hyperframes/producer": "0.7.107",
    "@hyperframes/studio": "^0.7.107",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "hyperframes": "0.7.106",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
