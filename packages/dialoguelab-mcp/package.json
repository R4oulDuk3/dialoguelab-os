{
  "name": "dialoguelab-mcp",
  "version": "0.1.0",
  "description": "Local-first Dialogue Lab authoring, TTS, subtitles, timeline editing, and HyperFrames rendering over MCP",
  "type": "module",
  "bin": {
    "dialoguelab-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "tts",
    "subtitles",
    "hyperframes"
  ],
  "license": "MIT",
